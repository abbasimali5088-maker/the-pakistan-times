# =============================================================================
# دی پاکستان ٹائمز اردو — Environment Variables
# Copy to .env for local development.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# =============================================================================

# --- PostgreSQL (required) ---
# Locally both URLs can be the same.
#
# Local example:
# DATABASE_URL="postgresql://pt_cms:pt_cms_dev@127.0.0.1:5432/pakistan_times?schema=public"
# DIRECT_DATABASE_URL="postgresql://pt_cms:pt_cms_dev@127.0.0.1:5432/pakistan_times?schema=public"
#
# Neon example (pooled + direct):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# Supabase + Vercel (IMPORTANT):
# Do NOT use db.xxxxx.supabase.co:5432 on Vercel — it is often IPv6-only and build fails with P1001.
# In Supabase → Project Settings → Database → Connection string:
#   - Method: "Session pooler"  → use for BOTH vars on Vercel (works with Prisma migrate)
#   - Or "Transaction pooler" for DATABASE_URL and Session pooler for DIRECT_DATABASE_URL
# Example Session pooler:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Session signing secret — REQUIRED in production (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-secret"

# Seed / bootstrap admin (used by npm run db:seed — run once against production DB)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Super Admin"

# Public brand + absolute site URL (must be https:// on Vercel)
NEXT_PUBLIC_SITE_NAME_UR="دی پاکستان ٹائمز اردو"
NEXT_PUBLIC_SITE_NAME_EN="The Pakistan Times"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_BASE="/api"

# Uploads (media stores remote URLs in DB; no local disk required on Vercel)
UPLOAD_MAX_MB="10"

# Cookie Secure flag:
# - leave unset on Vercel (auto https → secure cookies)
# - set "false" for local HTTP
# - set "true" to force Secure cookies
COOKIE_SECURE="false"

# Cron secret for live market rates auto-refresh (Vercel Cron → /api/rates/refresh)
# openssl rand -hex 24
CRON_SECRET="change-me-cron-secret"
