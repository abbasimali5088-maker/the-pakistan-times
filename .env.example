# =============================================================================
# دی پاکستان ٹائمز اردو — Environment Variables
# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
# =============================================================================

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
# Local example:
# DATABASE_URL="postgresql://pt_cms:pt_cms_dev@127.0.0.1:5432/pakistan_times?schema=public"
# Neon / Vercel example (use pooled URL for serverless if provided):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Session signing secret — generate a long random string for production
JWT_SECRET="change-me-to-a-long-random-secret"

# Seed / bootstrap admin (used by npm run db:seed)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Super Admin"

# Public brand + absolute site URL (must be https:// on Vercel)
NEXT_PUBLIC_SITE_NAME_UR="دی پاکستان ٹائمز اردو"
NEXT_PUBLIC_SITE_NAME_EN="The Pakistan Times"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_BASE="/api"

# Uploads
UPLOAD_MAX_MB="10"

# Cookie Secure flag:
# - leave unset on Vercel (auto https → secure cookies)
# - set "false" for local HTTP
# - set "true" to force Secure cookies
COOKIE_SECURE="false"
