generator client {
  provider      = "prisma-client-js"
  // native = local/dev; rhel-openssl-3.0.x = Vercel/AWS Lambda Node 20
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL goes in DATABASE_URL; put the direct (non-pooler) URL here for migrations.
  // Locally both can be the same connection string.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Site {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  language    String   @default("ur")
  timezone    String   @default("Asia/Karachi")
  isDefault   Boolean  @default(false)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  articles    Article[]
  categories  Category[]
  menus       Menu[]
  settings    Setting[]
  homepageBlocks HomepageBlock[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  code        String   @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  name            String
  status          String    @default("active")
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  roles           UserRole[]
  sessions        Session[]
  loginLogs       LoginLog[]
  authorProfile   Author?
  articles        Article[] @relation("ArticleAuthor")
  articleUpdates  Article[] @relation("ArticleUpdater")
  revisions       ArticleRevision[]
  mediaUploads    Media[]
  comments        Comment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  approvedBreaking BreakingNews[] @relation("BreakingApprover")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Author {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String
  slug        String   @unique
  email       String?
  photoUrl    String?
  bio         String?
  position    String?
  website     String?
  twitter     String?
  facebook    String?
  linkedin    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  articles    Article[] @relation("PrimaryAuthor")
  coArticles  ArticleCoAuthor[]
  videos      Video[]
  audio       Audio[]
  galleries   Gallery[]
}

model Category {
  id          String   @id @default(cuid())
  siteId      String?
  parentId    String?
  name        String
  nameUr      String?
  slug        String
  description String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  articles    Article[]
  videos      Video[]
  audio       Audio[]
  liveStories LiveStory[]

  @@unique([siteId, slug])
  @@index([parentId])
  @@index([status, sortOrder])
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  nameUr      String?
  slug        String   @unique
  description String?
  seoTitle    String?
  seoDescription String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  articles    ArticleTag[]
}

model Article {
  id              String   @id @default(cuid())
  siteId          String?
  title           String
  titleUr         String?
  slug            String
  subtitle        String?
  excerpt         String?
  excerptUr       String?
  body            String   @default("")
  bodyUr          String?
  language        String   @default("ur")
  status          String   @default("draft")
  workflowStep    String   @default("draft")
  priority        String   @default("normal")
  location        String?
  featuredImageId String?
  imageCaption    String?
  imageCredit     String?
  categoryId      String?
  authorId        String?
  createdById     String?
  updatedById     String?
  publishAt       DateTime?
  publishedAt     DateTime?
  unpublishedAt   DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  viewCount       Int      @default(0)
  isFeatured      Boolean  @default(false)
  isBreaking      Boolean  @default(false)
  canonicalUrl    String?
  seoTitle        String?
  seoDescription  String?
  focusKeyword    String?
  robotsMeta      String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  socialTitle     String?
  socialDescription String?
  schemaType      String   @default("NewsArticle")
  translationOfId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site            Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          Author?  @relation("PrimaryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy       User?    @relation("ArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?    @relation("ArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  featuredImage   Media?   @relation("ArticleFeatured", fields: [featuredImageId], references: [id], onDelete: SetNull)
  translationOf   Article? @relation("Translations", fields: [translationOfId], references: [id], onDelete: SetNull)
  translations    Article[] @relation("Translations")
  tags            ArticleTag[]
  coAuthors       ArticleCoAuthor[]
  revisions       ArticleRevision[]
  relationsFrom   ArticleRelation[] @relation("RelationFrom")
  relationsTo     ArticleRelation[] @relation("RelationTo")
  comments        Comment[]
  breakingNews    BreakingNews[]
  mediaUsages     MediaUsage[]
  homepageBlocks  HomepageBlock[]

  @@unique([siteId, slug])
  @@index([status, publishAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([language])
  @@index([priority])
  @@index([deletedAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleCoAuthor {
  articleId String
  authorId  String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([articleId, authorId])
}

model ArticleRevision {
  id           String   @id @default(cuid())
  articleId    String
  version      Int
  title        String
  body         String
  excerpt      String?
  snapshot     String
  note         String?
  userId       String?
  createdAt    DateTime @default(now())
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
  @@index([articleId])
}

model ArticleRelation {
  id              String  @id @default(cuid())
  fromArticleId   String
  toArticleId     String
  relationType    String
  fromArticle     Article @relation("RelationFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  toArticle       Article @relation("RelationTo", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@unique([fromArticleId, toArticleId, relationType])
}

model Media {
  id            String   @id @default(cuid())
  filename      String
  originalName  String
  path          String
  url           String
  mimeType      String
  size          Int
  width         Int?
  height        Int?
  alt           String?
  caption       String?
  credit        String?
  copyright     String?
  description   String?
  type          String   @default("image")
  variants      String?
  uploadedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  articles      Article[] @relation("ArticleFeatured")
  usages        MediaUsage[]
  galleryItems  GalleryItem[]

  @@index([type])
  @@index([mimeType])
}

model MediaUsage {
  id        String  @id @default(cuid())
  mediaId   String
  articleId String?
  context   String?
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model Video {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  provider    String   @default("upload")
  url         String
  thumbnail   String?
  duration    Int?
  categoryId  String?
  authorId    String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author      Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Audio {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  url         String
  coverUrl    String?
  duration    Int?
  episode     Int?
  season      Int?
  categoryId  String?
  authorId    String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author      Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  authorId    String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  items       GalleryItem[]
}

model GalleryItem {
  id        String  @id @default(cuid())
  galleryId String
  mediaId   String?
  imageUrl  String
  caption   String?
  credit    String?
  sortOrder Int     @default(0)
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media     Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
}

model BreakingNews {
  id          String   @id @default(cuid())
  headline    String
  headlineUr  String?
  priority    Int      @default(1)
  status      String   @default("draft")
  startAt     DateTime?
  endAt       DateTime?
  articleId   String?
  authorId    String?
  approverId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  approver    User?    @relation("BreakingApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([status, startAt, endAt])
}

model LiveStory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  authorId    String?
  categoryId  String?
  status      String   @default("draft")
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  updates     LiveUpdate[]
}

model LiveUpdate {
  id          String   @id @default(cuid())
  liveStoryId String
  body        String
  type        String   @default("text")
  mediaUrl    String?
  quote       String?
  location    String?
  priority    String   @default("normal")
  isPinned    Boolean  @default(false)
  isImportant Boolean  @default(false)
  status      String   @default("published")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  liveStory   LiveStory @relation(fields: [liveStoryId], references: [id], onDelete: Cascade)

  @@index([liveStoryId, publishedAt])
}

model Comment {
  id          String   @id @default(cuid())
  articleId   String
  userId      String?
  parentId    String?
  authorName  String?
  authorEmail String?
  body        String
  status      String   @default("pending")
  ip          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent      Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentThread")

  @@index([articleId, status])
}

model Poll {
  id        String   @id @default(cuid())
  question  String
  status    String   @default("draft")
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  votes  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voteRecords PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  voterKey  String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterKey])
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  optionsJson   String
  correctIndex  Int
  explanation   String?
  sortOrder     Int    @default(0)
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  score     Int
  total     Int
  answersJson String
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model NewsletterList {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  subscribers NewsletterSubscriber[]
  campaigns NewsletterCampaign[]
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  listId    String?
  email     String
  name      String?
  status    String   @default("active")
  token     String   @unique
  createdAt DateTime @default(now())
  unsubscribedAt DateTime?
  list      NewsletterList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@unique([listId, email])
}

model NewsletterCampaign {
  id          String   @id @default(cuid())
  listId      String?
  subject     String
  bodyHtml    String
  status      String   @default("draft")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  list        NewsletterList? @relation(fields: [listId], references: [id], onDelete: SetNull)
}

model Advertisement {
  id        String   @id @default(cuid())
  name      String
  unitKey   String
  code      String?
  imageUrl  String?
  targetUrl String?
  device    String   @default("all")
  priority  Int      @default(0)
  status    String   @default("active")
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitKey, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String?
  link      String?
  channel   String   @default("dashboard")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Menu {
  id        String   @id @default(cuid())
  siteId    String?
  name      String
  location  String   @default("main")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  items     MenuItem[]
}

model MenuItem {
  id        String  @id @default(cuid())
  menuId    String
  parentId  String?
  label     String
  labelUr   String?
  url       String
  target    String  @default("_self")
  sortOrder Int     @default(0)
  status    String  @default("active")
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MenuItem[] @relation("MenuTree")
}

model HomepageBlock {
  id          String   @id @default(cuid())
  siteId      String?
  sectionKey  String
  title       String?
  articleId   String?
  sortOrder   Int      @default(0)
  priority    Int      @default(0)
  isVisible   Boolean  @default(true)
  startAt     DateTime?
  endAt       DateTime?
  configJson  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([sectionKey, isVisible, sortOrder])
}

model StaticPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  bodyUr      String?
  status      String   @default("published")
  seoTitle    String?
  seoDescription String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  siteId    String?
  group     String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, group, key])
}

model Integration {
  id        String   @id @default(cuid())
  provider  String   @unique
  configJson String  @default("{}")
  status    String   @default("disabled")
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int     @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotFoundHit {
  id        String   @id @default(cuid())
  url       String   @unique
  hits      Int      @default(1)
  referrer  String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  path      String?
  articleId String?
  referrer  String?
  country   String?
  device    String?
  browser   String?
  source    String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([articleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  module     String
  recordId   String?
  oldValue   String?
  newValue   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
}

model BackupRecord {
  id         String   @id @default(cuid())
  type       String
  path       String
  size       Int?
  status     String   @default("completed")
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  note       String?
}

model Job {
  id          String   @id @default(cuid())
  type        String
  payloadJson String   @default("{}")
  status      String   @default("pending")
  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt])
}

model SeoAuditIssue {
  id        String   @id @default(cuid())
  entityType String
  entityId  String
  issueCode String
  severity  String   @default("warning")
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, severity])
}
